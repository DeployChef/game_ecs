@using Game.UI.Services

@if (RoundState != null)
{
    <div class="round-state">
        <div class="round-header">
            <h2>Ante @RoundState.Ante - Round @RoundState.Round</h2>
            @if (RoundState.IsComplete)
            {
                <span class="round-complete">✓ Раунд завершен!</span>
            }
        </div>
        
        <div class="score-progress">
            <div class="score-info">
                <span>Очки: @RoundState.Score / @RoundState.Goal</span>
                <span class="remaining">Осталось: @RoundState.Remaining</span>
            </div>
            <div class="progress-bar">
                @{
                    var progressPercent = GetProgressPercentage();
                    var widthPercent = progressPercent.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                }
                <div class="progress-fill" data-width="@widthPercent" style="width: @widthPercent% !important;"></div>
            </div>
            <div style="font-size: 0.75rem; color: #888; margin-top: 0.25rem; text-align: center;">
                Прогресс: @(progressPercent.ToString("F1"))% (@RoundState.Score из @RoundState.Goal)
            </div>
        </div>
        
        <div class="round-stats">
            <div class="stat">
                <span class="stat-label">Сыграно рук:</span>
                <span class="stat-value">@RoundState.HandsPlayed / @RoundState.MaxHandsToPlay</span>
            </div>
            <div class="stat">
                <span class="stat-label">Сброшено рук:</span>
                <span class="stat-value">@RoundState.HandsDiscarded / @RoundState.MaxHandsToDiscard</span>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public RoundStateViewModel? RoundState { get; set; }
    
    private double GetProgressPercentage()
    {
        if (RoundState == null)
            return 0;
        
        // Защита от деления на ноль
        if (RoundState.Goal <= 0)
            return 0;
        
        // Вычисляем процент: (Score / Goal) * 100
        // Явно приводим к double для правильного деления
        double score = (double)RoundState.Score;
        double goal = (double)RoundState.Goal;
        
        // Проверяем на валидность данных
        if (double.IsNaN(score) || double.IsNaN(goal) || double.IsInfinity(score) || double.IsInfinity(goal))
            return 0;
        
        double percentage = (score / goal) * 100.0;
        
        // Ограничиваем до 100% для визуального отображения
        // Если очков больше цели, показываем 100%
        double result = Math.Min(100.0, Math.Max(0.0, percentage));
        
        return result;
    }
}

